# Campaign output: regenerated per run, not source. baseline/ and pr-preview/ are kept
# reference evidence, not per-run output, so they stay tracked.
evidence/run-*/
runs/
*.log

# Local scratch
.DS_Store
__pycache__/
*.pyc

# Local credentials, never versioned
.env.local

# The skill is a deliverable of this repo. A global gitignore excludes .claude/,
# so re-include it: the directory first, then its contents.
!.claude/
!.claude/**
