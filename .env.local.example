# Copy to .env.local and fill in. .env.local is gitignored and chmod 600.
#
#   cp .env.local.example .env.local && chmod 600 .env.local
#
# local-stack/restore.sh sources .env.local automatically, so the values reach
# `docker compose up` without ever being written into a versioned file.

# The ocala (staging) TemplateFlow. NEVER production - rendering is POST /documents,
# a write. See docs/adr/0001.
AVANT_TEMPLATES_HOST=templateflow.ocala.k8s.dev.global.avant.com

# From the TemplateFlow pod's own environment:
#   kubectl -n templateflow-asm exec deploy/templateflow-01 -- printenv STAGING_API_KEY
# Take STAGING_API_KEY, not API_KEY: the latter is the prod legacy key and using it
# creates the prod legacy admin user in the staging database.
AVANT_TEMPLATES_API_KEY=

# Where the repo checkouts live, if not the default (../../.. from local-stack/).
# AVANT_ROOT=/Users/you/Source/avant
