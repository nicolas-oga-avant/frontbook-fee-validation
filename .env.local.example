# Copy to .env.local and fill in. .env.local is gitignored and chmod 600.
#
#   cp .env.local.example .env.local && chmod 600 .env.local
#
# local-stack/restore.sh sources .env.local automatically, so the values reach
# `docker compose up` without ever being written into a versioned file.

# Production TemplateFlow. Renders go out in PREVIEW mode, which does not persist a
# document (see docs/adr/0002), and pick up the latest DRAFT of the template - which is
# the artifact under test, since file-backed templates ship after the fee launch.
AVANT_TEMPLATES_HOST=templateflow.avant.com

# A PRODUCTION credential. It stays in this file and the process environment; never in
# local-stack/*.yml, and never in a commit. Ask a teammate if you do not have one.
AVANT_TEMPLATES_API_KEY=

# Where the repo checkouts live, if not the default (../../.. from local-stack/).
# AVANT_ROOT=/Users/you/Source/avant
